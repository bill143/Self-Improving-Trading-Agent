# Copy to .env (or export) — never commit real keys.

# The brain — required for autonomous runs. Alternatively `ant auth login`.
ANTHROPIC_API_KEY=

# Optional model override (default claude-opus-5).
# AGENCY_MODEL=claude-opus-5

# Where agency state lives (default ./state/agency).
# AGENCY_STATE_DIR=

# Live SMS via Twilio — leave blank to queue SMS to the outbox instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Planned integrations (actions queue to the outbox until wired):
GOHIGHLEVEL_API_KEY=
STRIPE_API_KEY=
DROPBOX_SIGN_API_KEY=
SYNTHFLOW_API_KEY=
