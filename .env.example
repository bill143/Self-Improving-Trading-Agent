# Copy to .env and edit. .env is gitignored — never commit real keys.

# Execution mode. "paper" simulates fills against live prices and risks no money.
# "live" requires BOTH flags below to be set; the live adapter is otherwise
# never imported. Leave as paper unless you fully understand the risk.
HERMES_TRADING_MODE=paper
HERMES_TRADING_I_ACCEPT_RISK=false

# Where state lives. Defaults to ./state locally, /app/state in Docker.
# HERMES_TRADING_STATE_DIR=

# Loop cadence in seconds (how often the worker evaluates the strategy).
# HERMES_TRADING_TICK_SECONDS=60

# Optional API keys — leave blank to use free public endpoints.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
GLASSNODE_API_KEY=
NEWS_API_KEY=
