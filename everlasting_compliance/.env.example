# ============================================================================
# Everlasting Care — NDIS Compliance Platform — environment file
# ----------------------------------------------------------------------------
# Copy this file to `.env` (in the repo root) and fill in the values.
# `.env` is git-ignored — real secrets NEVER get committed or pushed.
# Fill in the [NOW] items to run the AI fleet; [DEPLOY] items are only needed
# when we put it live on the Sydney server. Leave anything blank and that
# feature simply queues to the outbox instead of blocking the build.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI BRAIN  — [NOW]  (this powers the 5-agent fleet)
# ----------------------------------------------------------------------------
# Already set in the repo root .env. Get a key at platform.claude.com →
# Settings → API Keys → Create Key (starts with sk-ant-).
ANTHROPIC_API_KEY=
# Model the fleet runs on (default is fine).
EC_MODEL=claude-opus-5

# ----------------------------------------------------------------------------
# 2. APP SECURITY & STORAGE  — [DEPLOY]
# ----------------------------------------------------------------------------
# Where the database + state live. Default: ./state/everlasting_compliance
EC_STATE_DIR=
# Random secret for sessions / signing. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EC_SECRET_KEY=
# Encryption-at-rest key for participant data. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EC_ENCRYPTION_KEY=
# Database URL. Leave blank for SQLite (dev). For production Postgres on the
# Sydney server: postgresql://user:pass@localhost:5432/everlasting_compliance
EC_DB_URL=

# ----------------------------------------------------------------------------
# 3. DASHBOARD (read-only mission control)  — [DEPLOY]
# ----------------------------------------------------------------------------
EC_DASHBOARD_HOST=0.0.0.0
EC_DASHBOARD_PORT=8080
# Login for the management dashboard. Use a strong password.
EC_ADMIN_USERNAME=admin
EC_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# 4. TELEGRAM  — [NOW-ISH]  (Reach agent: staff reminders + incident intake)
# ----------------------------------------------------------------------------
# Create a bot: open Telegram, message @BotFather, send /newbot, follow the
# prompts, and it gives you a token like 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to use the bot (your staff).
# To find a chat ID, message @userinfobot from that account.
TELEGRAM_ALLOWED_CHAT_IDS=

# ----------------------------------------------------------------------------
# 5. EMAIL (SMTP)  — [OPTIONAL]  (Reach agent: email reminders)
# ----------------------------------------------------------------------------
# Any SMTP provider works (Gmail app-password, Microsoft 365, SendGrid, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=compliance@everlastingcare.com.au

# ----------------------------------------------------------------------------
# 6. NDIS / NDIA IDENTIFIERS  — [DEPLOY]
# ----------------------------------------------------------------------------
# IMPORTANT: the NDIS Commission Provider Portal and the NDIA myplace portal do
# NOT hand out API keys to providers. They are login-based (PRODA / myID + RAM),
# and claiming is done by uploading a bulk-claim CSV. So there is NOTHING secret
# to paste for claiming — the platform GENERATES the CSV for you to upload, and
# tracks every submission deadline. Never store your personal PRODA/myID login
# in this file. The values below are non-secret identifiers only.
NDIS_PROVIDER_REGISTRATION_ID=
NDIA_PROVIDER_ABN=
# Optional: a PRODA "B2B device"/RAM machine credential IF the provider has been
# set up for automated NDIA API access (most small providers are not — skip).
NDIA_B2B_DEVICE_KEY=

# ----------------------------------------------------------------------------
# 7. PROVIDER PROFILE OVERRIDES  — [OPTIONAL]
# ----------------------------------------------------------------------------
# Defaults live in everlasting_compliance/config.py; override here if needed.
EC_PROVIDER_NAME=Everlasting Care
EC_DATA_REGION=Sydney (AU)
# Scope toggles (true/false): restrictive-practices module and child-safety module
EC_MODULE_2A=true
EC_UNDER_18=false
